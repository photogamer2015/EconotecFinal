# Copia este archivo como .env y cambia los valores para tu servidor.
# No subas el archivo .env a GitHub.

DEBUG=False
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-segura
ALLOWED_HOSTS=econotec.ec.com,www.econotec.ec.com,tu-ip-publica
CSRF_TRUSTED_ORIGINS=https://econotec.ec.com,https://www.econotec.ec.com
GEMINI_API_KEY=

# SQLite funciona sin estas variables. Para MySQL/RDS, llena este bloque.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Backup opcional de SQLite a AWS S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1

# Correo real para doble factor y comprobantes.
# Usa una contraseña de aplicación SMTP, no la contraseña normal del correo.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu_correo@dominio.com
EMAIL_HOST_PASSWORD=tu_clave_smtp
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Econotec <tu_correo@dominio.com>
ECONOTEC_REPLY_TO=ventas@econotec.ec.com
INGRESO_EMAIL_AUTOMATICO=True
INGRESO_EMAIL_ADJUNTAR_PDF=True
SALIDA_EMAIL_AUTOMATICO=True
PAGO_EMAIL_AUTOMATICO=True
EQUIPO_EMAIL_ADJUNTAR_PDF=True

# Sesión persistente renovable (400 días), definida en core/settings.py.
# Cookies HTTPS cuando DEBUG=False.
# True solo detrás de un proxy propio que sanea X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False
# Activar únicamente cuando TODOS los subdominios usan HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
